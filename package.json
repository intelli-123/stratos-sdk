{
  "name": "@intelli-1113/stratos-sdk",
  "version": "1.3.5",
  "description": "Stratos AI agent telemetry (OpenLLMetry), Vercel AI auto-spans, LangChain inspect/fix, MCP proxy.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./register": "./src/register.js",
    "./inspect": "./src/inspect-langchain.js",
    "./otel-bridge": "./src/otel-bridge.js",
    "./otel-bridge-harness": "./src/otel-bridge-harness.js",
    "./execution-spans": "./src/execution-spans.js",
    "./config-templates": "./src/config-templates.js"
  },
  "bin": {
    "stratos": "./src/cli.js",
    "stratos-setup": "./src/cli-setup.js",
    "stratos-doctor": "./src/cli-doctor.js",
    "stratos-otel-bridge": "./src/otel-bridge.js",
    "stratos-mcp-proxy": "./src/mcp-proxy.js",
    "stratos-inspect": "./src/cli-inspect.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "postinstall": "node ./src/postinstall.js",
    "test": "node -e \"import('./src/index.js').then(m=>console.log('ok',Object.keys(m)))\"",
    "setup": "node ./src/cli.js setup claude-code",
    "doctor": "node ./src/cli.js doctor",
    "inspect": "node ./src/cli-inspect.js"
  },
  "keywords": [
    "stratos",
    "openllmetry",
    "opentelemetry",
    "observability",
    "llm",
    "agent",
    "vercel-ai",
    "langchain"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@traceloop/node-server-sdk": "^0.27.0",
    "cross-spawn": "^7.0.3",
    "import-in-the-middle": "^1.15.0",
    "require-in-the-middle": "^7.5.2"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  }
}
